<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.DetailsPage"
             Title="DetailsPage">
    <VerticalStackLayout>
        <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
        <Label Text="{Binding Category, StringFormat='Category: {0}'}" />
        <Label Text="{Binding Cost, StringFormat='Cost: {0:C}'}" />
        <Label Text="{Binding Quantity, StringFormat='In Stock: {0} pcs.'}" />
        <Label Text="{Binding StockPrice, StringFormat='Stock Price: {0:C}'}" />
        <Label x:Name="descriptionLabel" />
        <Button Text="Back to List" Clicked="BackButtonClicked" />
    </VerticalStackLayout>
</ContentPage>