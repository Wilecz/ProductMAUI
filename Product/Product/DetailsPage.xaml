<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.DetailsPage"
             Title="Product details">
    <ScrollView>
        <VerticalStackLayout 
            Padding="24" 
            Spacing="12">
            <Button
                Text="Remove"
                Clicked="ButtonRemover"
                x:Name="RemoveButton"
                HorizontalOptions="Center"
                BackgroundColor="IndianRed" />
            <Label
                x:Name="descriptionLabel"
                FontSize="20"/>
            <Entry
                Placeholder="Enter product name"
                ClearButtonVisibility="WhileEditing"
                x:Name="ProductNameEntry" />
            <Entry
                Placeholder="Enter product price"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                x:Name="ProductPriceEntry" />
            <Entry
                Placeholder="Enter product quantity"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing"
                x:Name="ProductQuantityEntry" />
            <Picker x:Name="ProductCategoryPicker">
                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                    <x:String>D</x:String>
                </Picker.Items>
            </Picker>

            <Button
                Text="Accept"
                Clicked="ButtonChanger"
                x:Name="ChangeButton" />
            <Button Text="Back to list" Clicked="BackButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>