<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.DetailsPage"
             Title="DetailsPage">
    <VerticalStackLayout>
        <Label 
            x:Name="descriptionLabel" 
            FontSize="20"/>
        <HorizontalStackLayout>
            <Entry
                HorizontalOptions="Center"
                Placeholder="Enter product name"
                x:Name="ProductNameEntry"/>
            <Entry
                HorizontalOptions="Center"
                Placeholder="Enter product price"
                Keyboard="Numeric"
                x:Name="ProductPriceEntry"/>
            <Entry
                HorizontalOptions="Center"
                Placeholder="Enter product quantity"
                Keyboard="Numeric"
                x:Name="ProductQuantityEntry"/>
            <Picker
                HorizontalOptions="Center"
                x:Name="ProductCategoryPicker">
                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                    <x:String>D</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>
        <Button
            FontSize="20"
            Text="Submit"
            Clicked="ButtonChanger"
            x:Name="ChangeButton"
            HorizontalOptions="Center"/>
        <Button Text="Back to List" Clicked="BackButtonClicked" />
    </VerticalStackLayout>
</ContentPage>