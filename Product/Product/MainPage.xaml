<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <VerticalStackLayout
                HeightRequest="120">
                <HorizontalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center"
                    TranslationY="40">
                    <Button Text="Details" Clicked="DetailButtonClicked" />
                </HorizontalStackLayout>
                <Label
                    FontSize="40"
                    x:Name="SearchText"
                    Text="Searching"
                    HorizontalOptions="Center" TranslationY="40"/>
            </VerticalStackLayout>
            <SearchBar
                Placeholder="Enter product name"
                TextChanged="ProductSearchTextChanged"
                x:Name="ProductSearchEntry"/>
            <Button
                Text="Search"
                Clicked="ButtonSearch"
                x:Name="SearchButton"/>
            
            <Entry
                Placeholder="Enter product name"
                x:Name="ProductNameEntry"/>
            <Entry
                Placeholder="Enter product price"
                Keyboard="Numeric"
                x:Name="ProductPriceEntry"/>
            <Entry
                Placeholder="Enter product quantity"
                Keyboard="Numeric"
                x:Name="ProductQuantityEntry"/>
            <Picker
                x:Name="ProductCategoryPicker">
                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                    <x:String>D</x:String>
                </Picker.Items>
            </Picker>
            <Button
                Text="Submit"
                Clicked="ButtonAdder"
                x:Name="AddButton"/>
            <Grid ColumnSpacing="10" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Cost" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Quantity" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Category" FontAttributes="Bold" />
            </Grid>
            <CollectionView
                x:Name="ProductCollectionView"
                SelectionMode="Single"
                ItemsSource="{Binding SeenProducts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="10"
                            Margin="5">
                            <Grid ColumnDefinitions="2*,*,*,*">
                                <Label Text="{Binding Name}" FontSize="20" Grid.Column="0"/>
                                <Label Text="{Binding Cost, StringFormat='Cost: {0:C}'}" Grid.Column="1"/>
                                <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" Grid.Column="2"/>
                                <Label Text="{Binding Category, StringFormat='Category: {0}'}" Grid.Column="3"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
