<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <VerticalStackLayout
                HeightRequest="120">
                <Label
                    FontSize="40"
                    x:Name="SearchText"
                    Text="Searching"
                    HorizontalOptions="Center" TranslationY="40"
                    />
            </VerticalStackLayout>
            <Entry
                Placeholder="Enter product name"
                x:Name="ProductSearchEntry"/>
            <Button
                Text="Search"
                Clicked="ButtonSearch"
                x:Name="SearchButton"/>
            
            <Entry
                Placeholder="Enter product name"
                x:Name="ProductNameEntry"/>
            <Entry
                Placeholder="Enter product price"
                Keyboard="Numeric"
                x:Name="ProductPriceEntry"/>
            <Entry
                Placeholder="Enter product quantity"
                Keyboard="Numeric"
                x:Name="ProductQuantityEntry"/>
            <Picker
                x:Name="ProductCategoryPicker">
                <Picker.Items>
                    <x:String>A</x:String>
                    <x:String>B</x:String>
                    <x:String>C</x:String>
                    <x:String>D</x:String>
                </Picker.Items>
            </Picker>
            <Button
                Text="Submit"
                Clicked="ButtonAdder"
                x:Name="AddButton"/>
            <Editor
                IsReadOnly="True"
                AutoSize="TextChanges"
                x:Name="Editor"/>
            <!--
            <Image
