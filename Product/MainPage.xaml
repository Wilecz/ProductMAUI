<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Product.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <VerticalStackLayout
                HeightRequest="120">
                <Label
                    HorizontalTextAlignment="Center"
                    FontSize="40"
                    x:Name="SearchText"
                    Text="Searching"/>
            </VerticalStackLayout>
            <Entry
                Placeholder="Enter product name"
                x:Name="Entry"/>
            <Button
                Text="Submit"
                Clicked="Buttoner"
                x:Name="Button"/>
            <Editor
                IsReadOnly="True"
                AutoSize="TextChanges"
                x:Name="Editor"/>
